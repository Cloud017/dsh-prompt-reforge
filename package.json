{
  "name": "dsh-prompt-reforge",
  "version": "0.2.0",
  "description": "Reforge a rough draft into a precise prompt inside the DSH composer, with one-click revert.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "composer",
    "ui"
  ],
  "license": "MIT",
  "author": "Cloud017",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloud017/dsh-prompt-reforge.git"
  },
  "bugs": {
    "url": "https://github.com/Cloud017/dsh-prompt-reforge/issues"
  },
  "homepage": "https://github.com/Cloud017/dsh-prompt-reforge#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
